# --- Di bawah ini adalah SECRET Edge Function, BUKAN variabel Vite. ---
# Set lewat Dashboard Supabase > Edge Functions > Secrets (atau `supabase secrets set`).
# JANGAN pernah menaruh service_role key / client secret di kode frontend atau .env yang ter-commit.

# SUPABASE_SERVICE_ROLE_KEY=   # service_role (hanya Edge Function)
# TOKEN_ENCRYPTION_KEY=        # 32 byte acak, base64url (untuk AES-256-GCM token provider)
# OAUTH_REDIRECT_URI=https://cliujpbiecvbskxiyxny.supabase.co/functions/v1/oauth-callback
# APP_REDIRECT_URI=http://localhost:5173/#/koneksi   # origin aplikasi (dev)

